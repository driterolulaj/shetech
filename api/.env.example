# She Tech API settings. Copy to .env (gitignored) for local use; on a server,
# set these as real environment variables (systemd, Docker, PM2…).

# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
# HOST=0.0.0.0
# NODE_ENV=production

# Public address of the website, used for links in notification emails
# PUBLIC_URL=https://shetech.com

# Behind nginx or another reverse proxy: trust its X-Forwarded-* headers
# (number of proxies, or an address like "loopback" / "10.0.0.5"). Already 1 on Vercel.
# TRUST_PROXY=1

# Only when the website calls the API on a different host (no proxy):
# comma-separated frontend origins allowed to call it
# CORS_ORIGINS=https://shetech.com,https://www.shetech.com
# 'Strict' (default) is right for same-site; use 'None' (https only) if the API is on another site
# COOKIE_SAMESITE=Strict

# ── Database (PostgreSQL 14+) ──────────────────────────────────────────────
# On Vercel, connecting a Neon database (Storage tab) sets DATABASE_URL and
# DATABASE_URL_UNPOOLED for you. Locally, point it at your own Postgres:
DATABASE_URL=postgres://shetech:password@localhost:5432/shetech
# Direct connection for migrations, when DATABASE_URL goes through a pooler
# DATABASE_URL_UNPOOLED=
# DB_POOL_SIZE=10

# ── Gmail (use an app password, not your account password) ───────────────
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Deliver enquiries somewhere other than GMAIL_USER
# MAIL_TO=
# MAIL_SENDER_NAME=She Tech

# ── Admin panel ───────────────────────────────────────────────────────────
# First admin, created on start-up only while there are no admins.
# Add more or reset a password later with: npm run admin:create -- you@example.com
ADMIN_EMAIL=you@gmail.com
ADMIN_PASSWORD=
# SESSION_DAYS=7
