# Copy to .env.local and fill in. All optional; see src/config/site.js.
# These are baked into the public JavaScript: never put secrets here.
# Server secrets (database, Gmail, admin) belong to the API: see api/.env.example.

# Inbox shown on the site and used for mailto links
VITE_CONTACT_EMAIL=

# Scheduling page embedded by "Book a call" (instead of the built-in request form)
# e.g. https://calendly.com/shetech/30min  or  https://cal.com/shetech/intro
VITE_BOOKING_URL=

# Where the API (../api) lives. Leave empty when /api is forwarded on the same
# domain (dev server, `npm start`, nginx). Set it only for a separate API host.
# VITE_API_URL=https://api.shetech.com

# Send forms somewhere other than the She Tech API (optional)
# Formspree:  https://formspree.io/f/your-form-id
# Web3Forms:  https://api.web3forms.com/submit   (+ VITE_FORM_ACCESS_KEY)
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=

# Social links (hidden when empty)
VITE_LINKEDIN_URL=
VITE_GITHUB_URL=
VITE_INSTAGRAM_URL=

# Show draft projects in a production build (they always show in `npm run dev`)
VITE_SHOW_DRAFTS=false

# Include the colour editor in a production build (the "studio" deployment;
# signed-in admins only, saves need GITHUB_TOKEN on the API). See api/README.md.
VITE_PALETTE_EDITOR=false
